# Product and Target Criteria (Extensible to any product or category)
TARGET_PRODUCT="MacBook Pro"
CATEGORY="Laptops"
MAX_PRICE=1990.0
MIN_RAM_GB=24
MIN_STORAGE_GB=1000
MIN_CHIP_GEN=3

# Email Alerts (Resend.com)
RESEND_API_KEY="your_resend_api_key"
ALERT_EMAIL_TO="your_email@gmail.com"
ALERT_EMAIL_FROM="Shopping Deals <onboarding@resend.dev>"

# AI Verification (Google Gemini Flash)
GEMINI_API_KEY="your_gemini_api_key"
GEMINI_MODEL="gemini-2.5-flash"

# Optional Proxy (ScraperAPI.com free tier)
SCRAPER_API_KEY=""

# AWS DynamoDB (defaults to local fallback file if AWS credentials not set)
DYNAMODB_TABLE_NAME="MacBookDeals"
AWS_REGION="us-east-1"
DEAL_TTL_DAYS=14
DEBUG=false
